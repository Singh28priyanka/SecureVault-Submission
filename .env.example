# Copy to .env and override for production. Never commit real secrets.

# ---- Backend security (MUST override in production) ----
# Base64-encoded 256-bit key used to sign JWTs.
JWT_SECRET=c2VjdXJldmF1bHQtc3VwZXItc2VjcmV0LWtleS1jaGFuZ2UtbWUtaW4tcHJvZC0yMDI1IQ==
# 32-byte master key for AES-256 vault encryption.
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef

# ---- Database (postgres profile) ----
DB_URL=jdbc:postgresql://localhost:5432/securevault
DB_USERNAME=securevault
DB_PASSWORD=securevault

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- CORS (comma-separated origins) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Optional: SMTP for email notifications ----
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
